{
  "name": "react-example",
  "private": true,
  "version": "1.3.77",
  "type": "module",
  "scripts": {
    "dev": "vite --host=0.0.0.0",
    "dev:frontend-v2": "vite --host=0.0.0.0",
    "dev:api": "tsx watch server/index.ts",
    "dev:api:v2": "API_PORT=3011 tsx watch server/index.ts",
    "dev:full": "concurrently \"npm run dev:api:v2\" \"npm run dev\"",
    "start:api": "node server-dist/index.mjs",
    "build": "npm run build:web && npm run build:api && npm run build:daily-report",
    "build:web": "vite build",
    "build:api": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=server-dist/index.mjs",
    "build:daily-report": "esbuild server/dailyReportCli.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=server-dist/daily-report.mjs",
    "test:crm-lead": "tsx --test server/crmCustomerLead.test.ts",
    "test:backend-http": "NODE_ENV=test RUN_BACKEND_HTTP_TESTS=1 tsx --test server/httpIntegration.test.ts",
    "test:backend-http:docker": "node scripts/run-backend-integration.mjs",
    "test:non-operating": "tsx --test src/components/nonOperatingFinanceUtils.test.ts src/components/nonOperatingFinanceRender.test.tsx server/nonOperatingFinance.test.ts",
    "crm:migrate": "tsx server/crmMigrationCli.ts",
    "crm:migrate:apply": "tsx server/crmMigrationCli.ts --apply",
    "return-finance:audit": "tsx server/returnFinanceMigrationCli.ts",
    "finance:audit:read-only": "tsx server/financeAuditCli.ts --read-only",
    "accounting:backfill": "node scripts/backfill-accounting-control-plane.mjs",
    "preview": "vite preview --host=0.0.0.0 --port=3010",
    "typecheck": "tsc --noEmit -p tsconfig.frontend.json",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "typecheck:server-tests": "tsc --noEmit -p tsconfig.server-tests.json",
    "check:unused": "tsc --noEmit -p tsconfig.frontend.json --noUnusedLocals --noUnusedParameters --allowUnreachableCode false && tsc --noEmit -p tsconfig.server.json --noUnusedLocals --noUnusedParameters --allowUnreachableCode false",
    "check:mutation-routes": "node scripts/check-mutation-routes.mjs",
    "test:production-scripts": "node --test scripts/preflight-production.test.mjs",
    "check:release": "node scripts/check-release-state.mjs",
    "check:architecture": "node scripts/check-architecture.mjs && node scripts/check-backend-architecture.mjs && npm run check:mutation-routes",
    "preflight:production": "node scripts/preflight-production.mjs",
    "smoke:public": "node scripts/smoke-public.mjs",
    "smoke:browser": "node scripts/browser-smoke.mjs",
    "test:forms-browser": "python3 scripts/browser-form-validation.py && python3 scripts/browser-purchase-draft-media.py && python3 scripts/browser-order-submission.py && python3 scripts/browser-return-submission.py && python3 scripts/browser-return-amounts.py",
    "test:mobile-browser": "python3 scripts/browser-mobile-workbench.py",
    "test:barcode-browser": "python3 scripts/browser-barcode-scanner.py",
    "test:barcode-browser:production": "BARCODE_SMOKE_PRODUCTION=1 python3 scripts/browser-barcode-scanner.py",
    "check:visual": "node scripts/check-visual-regression.mjs",
    "restore:drill": "bash scripts/pg_restore_drill.sh",
    "clean": "rm -rf dist server-dist server.js",
    "lint:ui": "node scripts/check-ui-contracts.mjs",
    "lint:design-system": "node scripts/check-design-system.mjs",
    "lint:analytics": "node scripts/check-analytics-frame.mjs",
    "lint:reuse": "node scripts/check-component-reuse.mjs",
    "lint:architecture": "npm run check:architecture",
    "check:performance": "node scripts/check-frontend-performance.mjs",
    "components:inventory": "node scripts/component-inventory.mjs",
    "lint:components": "node scripts/component-inventory.mjs --check && node scripts/check-component-boundaries.mjs && node scripts/check-frontend-rules.mjs",
    "lint": "npm run lint:components && npm run lint:ui && npm run lint:design-system && npm run lint:analytics && npm run lint:reuse && npm run lint:architecture && npm run typecheck && npm run check:unused",
    "test": "node scripts/run-tests.mjs",
    "verify:ci": "npm run typecheck && npm run typecheck:server && npm run typecheck:server-tests && npm run lint && npm test && npm run test:production-scripts && npm run build && npm run check:performance && npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.19",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/compression": "^1.8.1",
    "barcode-detector": "3.2.2",
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.2.0",
    "lucide-react": "^0.546.0",
    "pg": "^8.21.0",
    "react": "^19.0.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.1",
    "react-hook-form": "^7.84.0",
    "react-number-format": "^5.4.5",
    "recharts": "^3.10.1",
    "sonner": "^2.0.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.14",
    "zxing-wasm": "3.1.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.4",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.3"
  }
}
