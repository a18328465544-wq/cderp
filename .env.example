# Backend API port. Keep the production Nginx proxy and PM2 config in sync.
API_PORT="3001"

# Production keeps the in-process state projection on one explicit fork.
# A shared read model/Redis is required before changing this topology.
STATE_RUNTIME_MODE="single-instance"

# Login brute-force protection. Successful logins do not consume this quota.
LOGIN_RATE_LIMIT_WINDOW_MS="900000"
LOGIN_RATE_LIMIT_MAX="8"

# Expired login sessions are pruned on active session traffic at this interval.
SESSION_CLEANUP_INTERVAL_MS="900000"

# External inventory API token. Set a long random value before enabling third-party integrations.
OPEN_API_TOKEN="CHANGE_ME_TO_A_LONG_RANDOM_TOKEN"
OPEN_API_RATE_LIMIT_WINDOW_MS="60000"
OPEN_API_RATE_LIMIT_MAX="240"

# PostgreSQL is required for the backend API. The server no longer persists
# business data to data/app-state.json.
DATABASE_URL="postgresql://gpu_erp_user:CHANGE_ME@127.0.0.1:5432/gpu_erp"

# Set to true only when your PostgreSQL provider requires SSL.
DATABASE_SSL="false"

# Integration tests must use a separate database and must be run with NODE_ENV=test.
# Never point this at the production DATABASE_URL.
TEST_DATABASE_URL="postgresql://gpu_erp_user:CHANGE_ME@127.0.0.1:5432/gpu_erp_test"
TEST_DATABASE_SSL="false"
# Local one-command integration test: npm run test:backend-http:docker

# On first PostgreSQL startup, import legacy data/app-state.json if it exists.
# Keep false after the one-time PostgreSQL cutover. Production preflight rejects true.
POSTGRES_IMPORT_LEGACY_JSON="false"

# Daily PostgreSQL backup. Install ops/systemd/gpu-erp-backup.{service,timer};
# the timer runs scripts/pg_backup.sh at 03:20 Asia/Shanghai.
# Production preflight requires an explicit, readable backup directory and a
# recent dump. Keep it outside the application directory where possible.
BACKUP_DIR="/var/backups/gpu-erp"
BACKUP_RETENTION_DAYS="30"
BACKUP_MAX_AGE_HOURS="26"
REQUIRE_RECENT_BACKUP="true"
# Set to a real offsite/object-storage destination; placeholders fail preflight.
OFFSITE_BACKUP_TARGET="s3://replace-with-real-target"

# Optional: send Feishu group messages after a sales order is created or a market quote price changes.
# Keep the real webhook only in .env; never commit it.
FEISHU_SALES_WEBHOOK_URL=""
FEISHU_NOTIFICATION_TIMEOUT_MS="5000"

# Daily owner/finance report. Leave the URL empty to reuse FEISHU_SALES_WEBHOOK_URL (the outbound robot).
FEISHU_DAILY_REPORT_WEBHOOK_URL=""
FEISHU_DAILY_REPORT_CUTOFF="20:00"
FEISHU_DAILY_REPORT_MAX_ATTEMPTS="3"
FEISHU_DAILY_REPORT_RETRY_SECONDS="75"

# AI operating suggestions. Keep the API key on the server only; never expose it to the browser.
# DeepSeek's OpenAI-compatible endpoint is https://api.deepseek.com.
AI_PROVIDER="deepseek"
AI_BASE_URL="https://api.deepseek.com"
AI_MODEL="deepseek-v4-flash"
AI_API_KEY=""
# After a provider failure, temporarily use deterministic rule suggestions to avoid
# retry storms and noisy logs. Set 0 only for deliberate troubleshooting.
AI_PROVIDER_FAILURE_COOLDOWN_MS="300000"

# Restore drills must target an isolated PostgreSQL database and must never reuse DATABASE_URL.
# RESTORE_TEST_DATABASE_URL="postgresql://gpu_erp_user:CHANGE_ME@127.0.0.1:5432/gpu_erp_restore_test"

# Required in production. Used only when the initial owner account is first bootstrapped.
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-unique-password
